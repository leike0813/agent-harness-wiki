# Hash-bound fixture and archive bytes are SHA-256 verified from the working
# tree; Git for Windows with core.autocrlf=true rewrites them to CRLF on
# checkout. Keep committed bytes unchanged on every platform.
* -text

# Reference excerpts quote upstream source verbatim; upstream code blocks indent
# with tabs, so a YAML block-scalar indent (spaces) precedes a content tab. Do not
# report that as an indent defect; trailing whitespace and EOF newlines still apply.
knowledge/*/references/*.yaml whitespace=-space-before-tab
