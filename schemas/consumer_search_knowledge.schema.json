{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "release_id": {
      "type": "string",
      "pattern": "^web-v1-[a-f0-9]{40}$"
    },
    "knowledge_published_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "access_mode": {
      "type": "string",
      "enum": [
        "online",
        "offline"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "ambiguous",
        "not_found",
        "not_investigated"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "harness_id": {
            "type": "string"
          },
          "topic": {
            "type": "string",
            "enum": [
              "skills",
              "mcp",
              "custom_agents",
              "custom_providers",
              "hooks",
              "native_plugins",
              "configuration"
            ]
          },
          "edition_id": {
            "type": "string"
          },
          "section_id": {
            "type": "string"
          },
          "surface_ids": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "question_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "preview": {
            "type": "string"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_scope": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "reference_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]*$"
                },
                "snapshot_id": {
                  "type": "string",
                  "minLength": 1
                },
                "official_url": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "required": [
                "reference_id",
                "snapshot_id",
                "official_url"
              ],
              "additionalProperties": false
            }
          },
          "match": {
            "type": "string",
            "enum": [
              "exact_question_id",
              "exact_config_term",
              "exact_question_wording",
              "alias",
              "full_text",
              "filter"
            ]
          }
        },
        "required": [
          "harness_id",
          "topic",
          "edition_id",
          "section_id",
          "surface_ids",
          "question_ids",
          "preview",
          "source_refs",
          "source_scope",
          "match"
        ],
        "additionalProperties": false
      }
    },
    "next_cursor": {
      "type": "string"
    }
  },
  "required": [
    "release_id",
    "knowledge_published_at",
    "access_mode",
    "status",
    "items"
  ],
  "additionalProperties": false
}
