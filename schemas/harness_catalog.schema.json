{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "record_kind": {
      "type": "string",
      "enum": [
        "fixture",
        "production"
      ]
    },
    "products": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "harness_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reference_ids": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            }
          },
          "surfaces": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "surface_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]*$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "cli",
                    "ide",
                    "desktop",
                    "web",
                    "sdk"
                  ]
                },
                "reference_ids": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]*$"
                  }
                }
              },
              "required": [
                "surface_id",
                "name",
                "kind",
                "reference_ids"
              ],
              "additionalProperties": false
            }
          },
          "runtimes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "runtime_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]*$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "reference_ids": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]*$"
                  }
                }
              },
              "required": [
                "runtime_id",
                "name",
                "reference_ids"
              ],
              "additionalProperties": false
            }
          },
          "bindings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "surface_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]*$"
                },
                "runtime_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]*$"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "documented",
                    "unknown",
                    "conflict"
                  ]
                },
                "reference_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]*$"
                  }
                }
              },
              "required": [
                "surface_id",
                "status",
                "reference_ids"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "harness_id",
          "name",
          "aliases",
          "reference_ids",
          "surfaces",
          "runtimes",
          "bindings"
        ],
        "additionalProperties": false
      }
    },
    "references": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reference_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "harness_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "official_url": {
            "type": "string",
            "format": "uri"
          },
          "captured_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "snapshot": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "document",
                  "git_commit"
                ]
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "revision": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              "archive_path": {
                "type": "string",
                "pattern": "^archive\\/catalog\\/[a-zA-Z0-9_./-]+$"
              }
            },
            "required": [
              "kind",
              "sha256",
              "archive_path"
            ],
            "additionalProperties": false
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "excerpt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 800
          }
        },
        "required": [
          "reference_id",
          "harness_id",
          "official_url",
          "captured_at",
          "snapshot",
          "locator",
          "excerpt"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "record_kind",
    "products",
    "references"
  ],
  "additionalProperties": false
}
