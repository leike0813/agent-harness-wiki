{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 2
    },
    "builder_version": {
      "type": "string",
      "const": "4"
    },
    "release_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "profile": {
      "type": "string",
      "enum": [
        "fixture",
        "production"
      ]
    },
    "knowledge_published_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "current": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "harness_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "topic": {
            "type": "string",
            "enum": [
              "skills",
              "mcp",
              "custom_agents",
              "custom_providers",
              "hooks",
              "native_plugins",
              "configuration"
            ]
          },
          "edition_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          }
        },
        "required": [
          "harness_id",
          "topic",
          "edition_id"
        ],
        "additionalProperties": false
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      }
    },
    "artifacts": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    }
  },
  "required": [
    "schema_version",
    "builder_version",
    "release_id",
    "profile",
    "knowledge_published_at",
    "input_sha256",
    "current",
    "history",
    "artifacts"
  ],
  "additionalProperties": false
}
