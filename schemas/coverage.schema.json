{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "record_kind": {
      "type": "string",
      "enum": [
        "fixture",
        "production"
      ]
    },
    "coverage_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "target": {
      "type": "object",
      "properties": {
        "harness_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "surface": {
          "type": "string",
          "enum": [
            "cli",
            "ide",
            "desktop",
            "web",
            "sdk"
          ]
        },
        "distribution": {
          "type": "string",
          "minLength": 1
        },
        "os": {
          "type": "string",
          "enum": [
            "linux",
            "windows",
            "macos"
          ]
        },
        "arch": {
          "type": "string",
          "enum": [
            "x64",
            "arm64"
          ]
        },
        "execution_mode": {
          "type": "string",
          "enum": [
            "native",
            "wsl",
            "container",
            "remote"
          ]
        },
        "version_identity": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "release"
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "commit"
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "value"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "harness_id",
        "surface",
        "distribution",
        "os",
        "arch",
        "execution_mode",
        "version_identity"
      ],
      "additionalProperties": false
    },
    "topic": {
      "type": "string",
      "enum": [
        "skills",
        "mcp",
        "custom_agents",
        "custom_providers",
        "hooks",
        "native_plugins",
        "configuration"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "partial",
        "complete",
        "blocked"
      ]
    },
    "investigation_notes": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      }
    }
  },
  "required": [
    "schema_version",
    "record_kind",
    "coverage_id",
    "target",
    "topic",
    "status"
  ],
  "additionalProperties": false
}
