{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 2
    },
    "record_kind": {
      "type": "string",
      "enum": [
        "fixture",
        "production"
      ]
    },
    "reference_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "harness_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "locator": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "file_lines"
            },
            "file": {
              "type": "string",
              "minLength": 1
            },
            "start": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "end": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "kind",
            "file",
            "start",
            "end"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "symbol"
            },
            "file": {
              "type": "string",
              "minLength": 1
            },
            "symbol": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "file",
            "symbol"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "document_section"
            },
            "heading": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "heading"
          ],
          "additionalProperties": false
        }
      ]
    },
    "official_url": {
      "type": "string",
      "format": "uri"
    },
    "excerpt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800
    }
  },
  "required": [
    "schema_version",
    "record_kind",
    "reference_id",
    "harness_id",
    "snapshot_id",
    "locator",
    "official_url",
    "excerpt"
  ],
  "additionalProperties": false
}
