{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 3
    },
    "record_kind": {
      "type": "string",
      "enum": [
        "fixture",
        "production"
      ]
    },
    "selections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "harness_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "topic": {
            "type": "string",
            "enum": [
              "skills",
              "mcp",
              "custom_agents",
              "custom_providers",
              "hooks",
              "native_plugins",
              "configuration",
              "local_transcripts"
            ]
          },
          "edition_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          }
        },
        "required": [
          "harness_id",
          "topic",
          "edition_id"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "record_kind",
    "selections"
  ],
  "additionalProperties": false
}
