        "resource_kind": {
          "type": "string",
          "const": "manifest"
        },
        "knowledge_published_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "profile": {
          "type": "string",
          "enum": [
            "fixture",
            "production"
          ]
        },
        "history": {
          "type": "string",
          "const": "current_and_previous"
        },
        "catalog": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_./-]+\\.json$"
        },
        "topics": {
          "type": "string",
          "const": "topics/"
        },
        "sources": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_./-]+\\.json$"
        },
        "search": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_./-]+\\.json$"
        }
      },
