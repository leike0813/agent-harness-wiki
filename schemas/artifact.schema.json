{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "number",
          "const": 1
        },
        "record_kind": {
          "type": "string",
          "enum": [
            "fixture",
            "production"
          ]
        },
        "source_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "harness_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "artifact_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "kind": {
          "type": "string",
          "const": "git_checkout"
        },
        "checkout_path": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "schema_version",
        "record_kind",
        "source_id",
        "harness_id",
        "artifact_id",
        "kind",
        "checkout_path",
        "commit",
        "file",
        "content_sha256"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "number",
          "const": 1
        },
        "record_kind": {
          "type": "string",
          "enum": [
            "fixture",
            "production"
          ]
        },
        "source_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "harness_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "artifact_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "kind": {
          "type": "string",
          "const": "archived_document"
        },
        "archive_path": {
          "type": "string",
          "minLength": 1
        },
        "raw_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "extracted_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "extractor": {
          "type": "string",
          "const": "identity-markdown@1"
        }
      },
      "required": [
        "schema_version",
        "record_kind",
        "source_id",
        "harness_id",
        "artifact_id",
        "kind",
        "archive_path",
        "raw_sha256",
        "extracted_sha256",
        "extractor"
      ],
      "additionalProperties": false
    }
  ]
}
