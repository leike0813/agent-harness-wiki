{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "release_id": {
      "type": "string",
      "pattern": "^web-v1-[a-f0-9]{40}$"
    },
    "knowledge_published_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "access_mode": {
      "type": "string",
      "enum": [
        "online",
        "offline"
      ]
    },
    "history_scope": {
      "type": "string",
      "const": "current_and_previous"
    },
    "status": {
      "type": "string",
      "const": "response_too_large"
    },
    "harness_id": {
      "type": "string"
    },
    "surface_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "topic": {
      "type": "string",
      "enum": [
        "skills",
        "mcp",
        "custom_agents",
        "custom_providers",
        "hooks",
        "native_plugins",
        "configuration"
      ]
    },
    "edition_id": {
      "type": "string"
    },
    "resolution": {
      "type": "object",
      "properties": {
        "requested_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "selected_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "match_kind": {
          "type": "string",
          "enum": [
            "current",
            "exact",
            "prefix",
            "nearest_earlier",
            "source_only"
          ]
        },
        "requested_applicability": {
          "type": "string",
          "enum": [
            "mapped",
            "not_verified"
          ]
        }
      },
      "required": [
        "requested_version",
        "selected_version",
        "match_kind",
        "requested_applicability"
      ],
      "additionalProperties": false
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "section_id": {
            "type": "string"
          },
          "surface_ids": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "question_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "section_id",
          "surface_ids",
          "question_ids",
          "source_refs"
        ],
        "additionalProperties": false
      }
    },
    "message": {
      "type": "string"
    }
  },
  "required": [
    "release_id",
    "knowledge_published_at",
    "access_mode",
    "status",
    "message"
  ],
  "additionalProperties": false
}
