{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "release_id": {
          "type": "string",
          "pattern": "^web-v1-[a-f0-9]{40}$"
        },
        "knowledge_published_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "access_mode": {
          "type": "string",
          "enum": [
            "online",
            "offline"
          ]
        },
        "status": {
          "type": "string",
          "const": "ok"
        },
        "surface_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "schema_version": {
                  "type": "number",
                  "const": 2
                },
                "record_kind": {
                  "type": "string",
                  "enum": [
                    "fixture",
                    "production"
                  ]
                },
                "reference_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]*$"
                },
                "harness_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]*$"
                },
                "snapshot_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]*$"
                },
                "locator": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "file_lines"
                        },
                        "file": {
                          "type": "string",
                          "minLength": 1
                        },
                        "start": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        "end": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "kind",
                        "file",
                        "start",
                        "end"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "symbol"
                        },
                        "file": {
                          "type": "string",
                          "minLength": 1
                        },
                        "symbol": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "kind",
                        "file",
                        "symbol"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "document_section"
                        },
                        "heading": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "kind",
                        "heading"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "official_url": {
                  "type": "string",
                  "format": "uri"
                },
                "excerpt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 800
                }
              },
              "required": [
                "schema_version",
                "record_kind",
                "reference_id",
                "harness_id",
                "snapshot_id",
                "locator",
                "official_url",
                "excerpt"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "reference_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]*$"
                },
                "harness_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]*$"
                },
                "official_url": {
                  "type": "string",
                  "format": "uri"
                },
                "captured_at": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                },
                "excerpt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 800
                },
                "snapshot": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "document",
                        "git_commit"
                      ]
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "revision": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{40}$"
                    }
                  },
                  "required": [
                    "kind",
                    "sha256"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "reference_id",
                "harness_id",
                "official_url",
                "captured_at",
                "locator",
                "excerpt",
                "snapshot"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "release_id",
        "knowledge_published_at",
        "access_mode",
        "status",
        "surface_id",
        "source"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "release_id": {
          "type": "string",
          "pattern": "^web-v1-[a-f0-9]{40}$"
        },
        "knowledge_published_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "access_mode": {
          "type": "string",
          "enum": [
            "online",
            "offline"
          ]
        },
        "status": {
          "type": "string",
          "const": "not_found"
        },
        "surface_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "release_id",
        "knowledge_published_at",
        "access_mode",
        "status",
        "surface_id"
      ],
      "additionalProperties": false
    }
  ]
}
