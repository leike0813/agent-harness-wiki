{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "release_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "profile": {
      "type": "string",
      "enum": [
        "fixture",
        "production"
      ]
    },
    "knowledge_published_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "records": {
      "type": "object",
      "properties": {
        "harnesses": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "schema_version": {
                "type": "number",
                "const": 1
              },
              "record_kind": {
                "type": "string",
                "enum": [
                  "fixture",
                  "production"
                ]
              },
              "harness_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "aliases": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "surfaces": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "cli",
                    "ide",
                    "desktop"
                  ]
                }
              },
              "source_refs": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]*$"
                }
              }
            },
            "required": [
              "schema_version",
              "record_kind",
              "harness_id",
              "name",
              "aliases",
              "surfaces",
              "source_refs"
            ],
            "additionalProperties": false
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "schema_version": {
                "type": "number",
                "const": 1
              },
              "record_kind": {
                "type": "string",
                "enum": [
                  "fixture",
                  "production"
                ]
              },
              "source_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*$"
              },
              "harness_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*$"
              },
              "kind": {
                "type": "string",
                "const": "fixture_file"
              },
              "file": {
                "type": "string",
                "minLength": 1
              },
              "content_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "schema_version",
              "record_kind",
              "source_id",
              "harness_id",
              "kind",
              "file",
              "content_sha256"
            ],
            "additionalProperties": false
          }
        },
        "snapshots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "schema_version": {
                "type": "number",
                "const": 1
              },
              "record_kind": {
                "type": "string",
                "enum": [
                  "fixture",
                  "production"
                ]
              },
              "snapshot_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*$"
              },
              "source_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*$"
              },
              "target": {
                "type": "object",
                "properties": {
                  "harness_id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]*$"
                  },
                  "surface": {
                    "type": "string",
                    "enum": [
                      "cli",
                      "ide",
                      "desktop"
                    ]
                  },
                  "distribution": {
                    "type": "string",
                    "minLength": 1
                  },
                  "os": {
                    "type": "string",
                    "enum": [
                      "linux",
                      "windows",
                      "macos"
                    ]
                  },
                  "arch": {
                    "type": "string",
                    "enum": [
                      "x64",
                      "arm64"
                    ]
                  },
                  "execution_mode": {
                    "type": "string",
                    "enum": [
                      "native",
                      "wsl",
                      "container",
                      "remote"
                    ]
                  },
                  "version_identity": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "release"
                          },
                          "value": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "kind",
                          "value"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "commit"
                          },
                          "value": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "kind",
                          "value"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "required": [
                  "harness_id",
                  "surface",
                  "distribution",
                  "os",
                  "arch",
                  "execution_mode",
                  "version_identity"
                ],
                "additionalProperties": false
              },
              "content_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "source_fetched_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              }
            },
            "required": [
              "schema_version",
              "record_kind",
              "snapshot_id",
              "source_id",
              "target",
              "content_sha256",
              "source_fetched_at"
            ],
            "additionalProperties": false
          }
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "schema_version": {
                "type": "number",
                "const": 1
              },
              "record_kind": {
                "type": "string",
                "enum": [
                  "fixture",
                  "production"
                ]
              },
              "claim_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*$"
              },
              "fact_key": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "object",
                "properties": {
                  "harness_id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]*$"
                  },
                  "surface": {
                    "type": "string",
                    "enum": [
                      "cli",
                      "ide",
                      "desktop"
                    ]
                  },
                  "distribution": {
                    "type": "string",
                    "minLength": 1
                  },
                  "os": {
                    "type": "string",
                    "enum": [
                      "linux",
                      "windows",
                      "macos"
                    ]
                  },
                  "arch": {
                    "type": "string",
                    "enum": [
                      "x64",
                      "arm64"
                    ]
                  },
                  "execution_mode": {
                    "type": "string",
                    "enum": [
                      "native",
                      "wsl",
                      "container",
                      "remote"
                    ]
                  }
                },
                "required": [
                  "harness_id",
                  "surface",
                  "distribution",
                  "os",
                  "arch",
                  "execution_mode"
                ],
                "additionalProperties": false
              },
              "version_applicability": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "exact"
                  },
                  "versions": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "oneOf": [
                          {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "type": "string",
                                "const": "release"
                              },
                              "value": {
                                "type": "string",
                                "minLength": 1
                              }
                            },
                            "required": [
                              "kind",
                              "value"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "type": "string",
                                "const": "commit"
                              },
                              "value": {
                                "type": "string",
                                "minLength": 1
                              }
                            },
                            "required": [
                              "kind",
                              "value"
                            ],
                            "additionalProperties": false
                          }
                        ]
                      }
                    ],
                    "items": false,
                    "minItems": 1,
                    "maxItems": 1
                  }
                },
                "required": [
                  "kind",
                  "versions"
                ],
                "additionalProperties": false
              },
              "topic": {
                "type": "string",
                "enum": [
                  "skills",
                  "mcp",
                  "custom_agents",
                  "custom_providers",
                  "hooks",
                  "native_plugins",
                  "configuration"
                ]
              },
              "assertion": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
