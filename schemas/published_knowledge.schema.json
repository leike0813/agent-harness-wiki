                      },
                      "scope": {
                        "type": "string",
                        "enum": [
                          "user",
                          "project",
                          "workspace"
                        ]
                      },
                      "path": {
                        "type": "object",
                        "properties": {
                          "base": {
                            "type": "string",
                            "enum": [
                              "home",
                              "project_root",
                              "workspace_root",
                              "cwd",
                              "config_root",
                              "installation_root",
                              "os_config_root",
                              "environment_variable"
                            ]
                          },
                          "variable": {
                            "type": "string",
                            "pattern": "^[A-Z][A-Z0-9_]*$"
                          },
                          "segments": {
                            "maxItems": 16,
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 255,
                              "pattern": "^(?!\\.\\.?$)[^\\\\/\\x00]+$"
                            }
                          }
                        },
                        "required": [
                          "base",
                          "segments"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "type",
                      "scope",
                      "path"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "transport_support"
                      },
                      "transport": {
                        "type": "string",
                        "enum": [
                          "stdio",
                          "http",
                          "sse"
                        ]
                      }
                    },
                    "required": [
                      "type",
                      "transport"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "discovery_rule"
                      },
                      "subject": {
                        "type": "string",
                        "const": "agent"
                      },
                      "rule": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "type",
                      "subject",
                      "rule"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "provider_protocol"
                      },
                      "protocol": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "type",
                      "protocol"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "hook_event"
                      },
                      "event": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "type",
                      "event"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "plugin_lifecycle"
                      },
                      "stage": {
                        "type": "string",
                        "enum": [
                          "installed",
                          "enabled",
                          "discovered",
                          "loaded",
                          "active",
                          "healthy"
                        ]
                      },
                      "mechanism": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "type",
                      "stage",
                      "mechanism"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "precedence_rule"
                      },
                      "higher": {
                        "type": "string",
                        "minLength": 1
                      },
                      "lower": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "type",
                      "higher",
                      "lower"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "capability_support"
                      },
                      "capability": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "type",
                      "capability"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "conditions": {
                "type": "object",
                "properties": {
                  "all_of": {
                    "maxItems": 12,
                    "type": "array",
                    "items": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "const": "workspace_trust"
                            },
                            "equals": {
                              "type": "string",
                              "enum": [
                                "trusted",
                                "untrusted"
                              ]
                            }
                          },
                          "required": [
                            "type",
                            "equals"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "const": "environment_variable"
                            },
                            "name": {
                              "type": "string",
                              "pattern": "^[A-Z][A-Z0-9_]*$"
                            },
                            "operator": {
                              "type": "string",
                              "enum": [
                                "set",
                                "unset"
                              ]
                            }
                          },
                          "required": [
                            "type",
                            "name",
                            "operator"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "const": "feature_flag"
                            },
                            "name": {
                              "type": "string",
                              "minLength": 1
                            },
                            "equals": {
                              "type": "boolean"
                            }
                          },
                          "required": [
                            "type",
                            "name",
                            "equals"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "const": "config_value"
                            },
                            "key": {
                              "type": "string",
                              "minLength": 1
                            },
                            "equals": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "type",
                            "key",
                            "equals"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "const": "launch_argument"
                            },
                            "name": {
                              "type": "string",
                              "minLength": 1
                            },
                            "present": {
                              "type": "boolean"
                            }
                          },
                          "required": [
                            "type",
                            "name",
                            "present"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "const": "profile"
                            },
                            "equals": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "type",
                            "equals"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "const": "extension_installed"
                            },
                            "id": {
                              "type": "string",
                              "pattern": "^[a-z][a-z0-9_-]*$"
                            },
                            "equals": {
                              "type": "boolean"
                            }
                          },
                          "required": [
                            "type",
                            "id",
                            "equals"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    }
                  }
                },
                "required": [
                  "all_of"
                ],
                "additionalProperties": false
              },
              "support": {
                "type": "object",
                "properties": {
                  "availability": {
                    "type": "string",
                    "enum": [
                      "supported",
                      "unsupported",
                      "not_applicable"
                    ]
                  },
                  "delivery": {
                    "type": "string",
                    "enum": [
                      "native",
                      "bundled",
                      "external_extension",
                      "workaround"
                    ]
                  }
                },
                "required": [
                  "availability"
                ],
                "additionalProperties": false
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]*$"
                }
              },
              "assessment_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]*$"
                }
              },
              "supersedes": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*$"
              }
            },
            "required": [
              "schema_version",
              "record_kind",
              "claim_id",
              "fact_key",
              "target",
              "version_applicability",
              "topic",
              "assertion",
              "conditions",
              "support",
              "evidence_refs",
              "assessment_refs"
            ],
            "additionalProperties": false
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "schema_version": {
                "type": "number",
                "const": 1
              },
              "record_kind": {
                "type": "string",
                "enum": [
                  "fixture",
                  "production"
                ]
              },
              "evidence_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*$"
              },
              "claim_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*$"
              },
              "snapshot_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*$"
              },
              "locator": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
