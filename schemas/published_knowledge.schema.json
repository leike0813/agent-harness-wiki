                "type": "string",
                "enum": [
                  "supports",
                  "refutes",
                  "qualifies"
                ]
              },
              "basis": {
                "type": "string",
                "enum": [
                  "documented",
                  "source_inspected",
                  "runtime_observed"
                ]
              }
            },
            "required": [
              "schema_version",
              "record_kind",
              "evidence_id",
              "claim_id",
              "snapshot_id",
              "locator",
              "excerpt",
              "stance",
              "basis"
            ],
            "additionalProperties": false
          }
        },
        "assessments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "schema_version": {
                "type": "number",
                "const": 1
              },
              "record_kind": {
                "type": "string",
                "enum": [
                  "fixture",
                  "production"
                ]
              },
              "assessment_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*$"
              },
              "claim_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*$"
