{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "record_kind": {
      "type": "string",
      "enum": [
        "fixture",
        "production"
      ]
    },
    "guide_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "coverage_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "claim_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      }
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 6000
    }
  },
  "required": [
    "schema_version",
    "record_kind",
    "guide_id",
    "coverage_ref",
    "claim_refs",
    "title",
    "body"
  ],
  "additionalProperties": false
}
