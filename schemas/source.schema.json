{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "number",
          "const": 1
        },
        "record_kind": {
          "type": "string",
          "enum": [
            "fixture",
            "production"
          ]
        },
        "source_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "harness_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "kind": {
          "type": "string",
          "const": "fixture_file"
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "schema_version",
        "record_kind",
        "source_id",
        "harness_id",
        "kind",
        "file",
        "content_sha256"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "number",
          "const": 1
        },
        "record_kind": {
          "type": "string",
          "enum": [
            "fixture",
            "production"
          ]
        },
        "source_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "harness_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "kind": {
          "type": "string",
          "const": "git_repository"
        },
        "repository_url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "schema_version",
        "record_kind",
        "source_id",
        "harness_id",
        "kind",
        "repository_url"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "number",
          "const": 1
        },
        "record_kind": {
          "type": "string",
          "enum": [
            "fixture",
            "production"
          ]
        },
        "source_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "harness_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "kind": {
          "type": "string",
          "const": "official_documentation"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "schema_version",
        "record_kind",
        "source_id",
        "harness_id",
        "kind",
        "url"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "number",
          "const": 1
        },
        "record_kind": {
          "type": "string",
          "enum": [
            "fixture",
            "production"
          ]
        },
        "source_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "harness_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "kind": {
          "type": "string",
          "const": "npm_registry"
        },
        "package_name": {
          "type": "string",
          "minLength": 1
        },
        "registry_url": {
          "type": "string",
          "const": "https://registry.npmjs.org"
        }
      },
      "required": [
        "schema_version",
        "record_kind",
        "source_id",
        "harness_id",
        "kind",
        "package_name",
        "registry_url"
      ],
      "additionalProperties": false
    }
  ]
}
