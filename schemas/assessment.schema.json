{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "record_kind": {
      "type": "string",
      "enum": [
        "fixture",
        "production"
      ]
    },
    "assessment_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "claim_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "accepted",
        "disputed",
        "rejected"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      }
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "fact_verified_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "record_kind",
    "assessment_id",
    "claim_id",
    "status",
    "evidence_refs",
    "reviewer",
    "fact_verified_at",
    "rationale"
  ],
  "additionalProperties": false
}
