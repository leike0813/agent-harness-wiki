# Dependencies
node_modules/
/research/package-set/node_modules
.pnp/
.pnp.js
.pnpm-store/

# Build output
dist/
build/
packages/consumer/LICENSE
packages/consumer/LICENSE-knowledge
packages/consumer/NOTICE
*.tsbuildinfo

# Local var (jobs sqlite, downloads, raw artifacts)
# Anchor these to the repo root: an unanchored `archive/` also matched
# openspec/changes/archive/, hiding archived OpenSpec changes from git.
/var/
/var/**
/archive/

# Release artifacts (immutable per PRD §12.5; rebuilt via builder)
/releases/

# VitePress build
site/.vitepress/cache/
site/.vitepress/dist/

# Test / coverage
/coverage/
.nyc_output/
*.lcov

# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo

# Env / secrets (templates only via .env.example)
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Tooling dotfiles generated locally by various agent harnesses / IDEs / skill managers.
# These are runtime caches / installs, not project source. The project
# harness Skills below are the only tracked subtrees under .agents/.
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/harness-investigation/
!.agents/skills/harness-investigation/**
!.agents/skills/harness-maintenance/
!.agents/skills/harness-maintenance/**
!.agents/skills/harness-binary/
!.agents/skills/harness-binary/**
!.agents/skills/harness-monitor/
!.agents/skills/harness-monitor/**
.claude/
.codegraph/
.playwright-mcp/
.kilocode/
.mattpack/
.omp/*
!.omp/config.yml
.opencode/
.openviking/
.pi/

# SQLite transient files (PRD §12.2; only release/*.sqlite is checked in)
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Editor backup
*~
*.bak
*.orig
